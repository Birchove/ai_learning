│   ├── seer.py       # 预言家 Agent
│   ├── witch.py      # 女巫 Agent
│   ├── hunter.py     # 猎人 Agent
│   └── villager.py   # 平民 Agent
├── server/
│   ├── app.py        # FastAPI 应用 + 路由
│   ├── models.py     # Pydantic 响应模型
│   └── controller.py # 游戏生命周期管理
├── frontend/
│   └── index.html    # 观战台 UI
├── main.py           # CLI 入口
└── .claude/
    └── reference/    # 需求文档
```

## API 端点
| 方法 | 路径 | 说明 |
|------|------|------|
| GET | / | 前端观战台 |
| GET | /api/games | 列出所有游戏 |
| POST | /api/games | 创建新游戏 |
| GET | /api/games/{id} | 游戏状态 |
| POST | /api/games/{id}/run | 启动 AI 自动对战 |
| GET | /api/games/{id}/log | 结构化日志 |
| GET | /api/games/{id}/summaries | Agent 赛后总结 |
| GET | /api/games/{id}/detail | 完整详情（时间线+推理） |
| GET | /docs | Swagger API 文档 |
| GET | /openapi.json | OpenAPI 规范 |

