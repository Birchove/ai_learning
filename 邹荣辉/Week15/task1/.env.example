#modelscope download --model OpenDataLab/MinerU2.5-Pro-2604-1.2B --local_dir ./dir C:/Users/Administrator/Desktop/研究生/ai2026/AI大模型学习/models/mineru/MinerU2.5-Pro-2604-1.2B
# ===== 模型本地路径 =====
# 五个模型均本地部署，不调线上 API
MINERU_MODEL_PATH=C:/Users/Administrator/Desktop/研究生/ai2026/AI大模型学习/models/mineru/MinerU2.5-Pro-2604-1.2B
BGE_MODEL_PATH=C:/Users/Administrator/Desktop/研究生/ai2026/AI大模型学习/models/BAAI/bge-small-zh-v1.5
CLIP_MODEL_PATH=C:/Users/Administrator/Desktop/研究生/ai2026/AI大模型学习/models/CLIP/chinese-clip-vit-base-patch16
RERANKER_MODEL_PATH=C:/Users/Administrator/Desktop/研究生/ai2026/AI大模型学习/models/BAAI/bge-reranker-base
QWEN_VL_MODEL_PATH=C:/Users/Administrator/Desktop/研究生/ai2026/AI大模型学习/models/Qwen/Qwen2.5-VL-7B-Instruct

# 推理设备
TORCH_DEVICE=cuda:0
QWEN_VL_DTYPE=bfloat16

# ===== 中间件地址 =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PARSE_TOPIC=doc_parse
KAFKA_CONSUMER_GROUP=parse-worker

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TEXT_COLLECTION=text_chunks
MILVUS_IMAGE_COLLECTION=image_chunks

SQLITE_PATH=./data/app.db

# ===== 本地存储 =====
DATA_DIR=./data
PDF_DIR=./data/pdfs
PARSED_DIR=./data/parsed
# FastAPI StaticFiles 把 PARSED_DIR 挂在这个 URL 前缀下
STATIC_URL_PREFIX=/static

# ===== 检索参数（与 README 锁定值一致，谨慎修改）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
BM25_TOP_K=100
BGE_TOP_K=100
CLIP_TOP_K=50
RERANK_TOP_K=10

# ===== 生成参数 =====
QWEN_VL_MAX_INPUT_TOKENS=4000
QWEN_VL_MAX_OUTPUT_TOKENS=1000
QWEN_VL_MAX_IMAGES=3

# ===== 服务端口 =====
UPLOAD_API_PORT=8001
CHAT_API_PORT=8002

# ===== 日志 =====
LOG_LEVEL=INFO
